#!/usr/bin/env python3
"""Register every skill with Claude Code, Pi and Hermes. Run after adding, renaming or removing a skill.

Skills live in core/skills/, sections/*/skills/ and accounts/*/skills/. This script
links each one into .claude/skills/<name> (Claude Code) and .agents/skills/<name>
(Pi and Hermes, which both scan that folder in trusted projects). `--check` changes
nothing and exits 1 if any link is out of date.
"""
import glob, os, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
check = "--check" in sys.argv
problems = []

skills = sorted(os.path.dirname(p) for pattern in
                ("core/skills/*/SKILL.md", "sections/*/skills/*/SKILL.md", "accounts/*/skills/*/SKILL.md")
                for p in glob.glob(pattern))
want = {os.path.basename(s): os.path.join("..", "..", s) for s in skills}

for link_dir in (os.path.join(".claude", "skills"), os.path.join(".agents", "skills")):
    have = {}
    if os.path.isdir(link_dir):
        for name in os.listdir(link_dir):
            path = os.path.join(link_dir, name)
            if os.path.islink(path):
                have[name] = os.readlink(path)
    for name in sorted(set(have) - set(want)):
        problems.append(f"stale skill link {link_dir}/{name}")
        if not check:
            os.unlink(os.path.join(link_dir, name))
    for name, target in want.items():
        if have.get(name) != target:
            problems.append(f"missing or wrong skill link {link_dir}/{name}")
            if not check:
                os.makedirs(link_dir, exist_ok=True)
                path = os.path.join(link_dir, name)
                if os.path.lexists(path):
                    os.unlink(path)
                os.symlink(target, path)

if check:
    if problems:
        print("\n".join(problems) + "\nrun scripts/link-skills")
        sys.exit(1)
else:
    print(f"{len(want)} skills linked into .claude/skills and .agents/skills")
