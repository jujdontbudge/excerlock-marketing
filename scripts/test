#!/usr/bin/env python3
"""Run offline helper checks, actual memory registration checks and crawler tests."""
from pathlib import Path
import subprocess
import sys
ROOT = Path(__file__).resolve().parents[1]
commands = [
    [str(ROOT / '.venv/bin/python'), 'integrations/sideshift/test_offline.py'],
    [str(ROOT / '.venv/bin/python'), 'integrations/contacts-mcp/test_offline.py'],
    [str(ROOT / '.venv/bin/python'), 'sections/creators/tests/test_offline.py'],
    [str(ROOT / '.venv/bin/python'), '-m', 'unittest', 'discover', '-s', 'tools/tests', '-v'],
    ['node', '--test', 'integrations/mem0-local/test_project_policy.mjs'],
    [str(ROOT / 'integrations/crawlee-crawl4ai/.venv/bin/python'), '-m', 'pytest', '-q', 'integrations/crawlee-crawl4ai/test_scraper.py'],
]
for command in commands:
    result = subprocess.run(command, cwd=ROOT)
    if result.returncode:
        sys.exit(result.returncode)
print('test: all configured checks passed')
