      "fontSize": 17,
      "fontFamily": 5,
      "text": "Outside git\n\n\u2022 bulk JSONL + raw evidence\n\u2022 downloaded media + OCR\n\u2022 generated slideshow images\n\u2022 review pages + verdicts\n\u2022 API usage and cost receipts\n\nCommitted reports point here instead\nof duplicating large/private artifacts.",
      "rawText": "Outside git\n\n\u2022 bulk JSONL + raw evidence\n\u2022 downloaded media + OCR\n\u2022 generated slideshow images\n\u2022 review pages + verdicts\n\u2022 API usage and cost receipts\n\nCommitted reports point here instead\nof duplicating large/private artifacts.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Outside git\n\n\u2022 bulk JSONL + raw evidence\n\u2022 downloaded media + OCR\n\u2022 generated slideshow images\n\u2022 review pages + verdicts\n\u2022 API usage and cost receipts\n\nCommitted reports point here instead\nof duplicating large/private artifacts.",
      "autoResize": true,
      "lineHeight": 1.25
    },
