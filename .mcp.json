{
  "mcpServers": {
    "fal": {
      "url": "https://mcp.fal.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${FAL_KEY}"
      },
      "lifecycle": "lazy",
      "requestTimeoutMs": 90000,
      "directTools": false,
      "approveTools": [
        "run_model",
        "submit_job"
      ]
    }
  }
}
